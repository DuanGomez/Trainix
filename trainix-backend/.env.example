# ============================================================
# TRAINIX API — Variables de entorno
# Copia este archivo como .env (en esta misma carpeta) y ajusta los valores.
# ============================================================

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:4200

# Base de datos (SQLite: un archivo local, no requiere instalar nada)
DB_PATH=data/trainix.sqlite
# Crea/actualiza las tablas automáticamente a partir de las entidades
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=cambia-esto-por-una-clave-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-por-otra-clave-de-al-menos-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Usuario administrador del seed (npm run seed)
SUPER_ADMIN_EMAIL=admin@trainix.app
SUPER_ADMIN_PASSWORD=Trainix2024!
